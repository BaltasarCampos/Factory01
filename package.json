{
  "name": "factory",
  "version": "0.0.0",
  "description": "Software Factory: a spec-driven, Owner-gated assembly line of Claude Code agents",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "factory": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run --project unit --project property --project contract --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:formal": "bash scripts/tlc.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.eslint.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "fast-check": "3.23.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.7"
  }
}
