#!/usr/bin/env node
// A stand-in for `systemctl --user` in the deploy tests (T069, slice 23b-2a), on PATH only where
// a test puts it. It records each call in $HOME/.fake-systemd/calls; `restart` starts what the
// unit would serve: an HTTP server on the unit's port when the release the unit names holds a
// file `serves`, else nothing, as an app that never listens; `show` reports the unit active, with
// that server as its main process, while it runs, and the backup's last result as the file
// `backup-result` holds it, else none yet. With a file `down` in that folder it fails as
// it does without a user manager, and with `fail-restart` every `restart` fails: systemctl gets
// only PATH, HOME and the bus's variables, so no other variable reaches it.
import { spawn } from 'node:child_process';
import {
  appendFileSync,
  existsSync,
  mkdirSync,
  readFileSync,
  rmSync,
  writeFileSync,
} from 'node:fs';
import { join } from 'node:path';

const args = process.argv.slice(2);
const home = process.env.HOME ?? '';
const state = join(home, '.fake-systemd');
mkdirSync(state, { recursive: true });
appendFileSync(join(state, 'calls'), `${args.join(' ')}\n`);
if (existsSync(join(state, 'down')) || args[0] !== '--user') {
  console.error('Failed to connect to bus: No medium found');
  process.exit(1);
}
const [verb, ...rest] = args.slice(1).filter((a) => a !== '--runtime');
const unit = rest.at(-1) ?? '';
const pidFile = join(state, `${unit}.pid`);
if (verb === 'restart' && existsSync(join(state, 'fail-restart'))) {
  console.error(`Job for ${unit} failed because the control process exited with error code.`);
  process.exit(1);
}
if (verb === 'show' && rest.includes('--property=Result,ExecMainExitTimestamp')) {
  const result = join(state, 'backup-result');
  console.log(
    existsSync(result) ? readFileSync(result, 'utf8') : 'Result=success\nExecMainExitTimestamp=',
  );
}
if (verb === 'show' && rest.includes('--property=MainPID')) {
  const pid = existsSync(pidFile) ? readFileSync(pidFile, 'utf8') : '0';
  console.log(`MainPID=${pid}\nActiveState=${pid === '0' ? 'inactive' : 'active'}`);
}
if (verb === 'restart' || verb === 'stop') {
  if (existsSync(pidFile)) {
    try {
      process.kill(Number(readFileSync(pidFile, 'utf8')));
    } catch {
      // Already gone.
    }
    rmSync(pidFile);
  }
}
if (verb === 'restart') {
  const text = readFileSync(join(home, '.config', 'systemd', 'user', unit), 'utf8');
  const [, repo = '', release = '', port = ''] =
    / service app (\S+) (\S+) --port (\d+)$/m.exec(text) ?? [];
  const folder = join(home, '.local', 'share', 'factory', 'apps', repo, 'releases', release);
  if (existsSync(join(folder, 'serves'))) {
    const serve = `require('node:http').createServer((q, s) => s.end('ok')).listen(${port}, '127.0.0.1'); setTimeout(() => process.exit(0), 120000);`;
    const child = spawn(process.execPath, ['-e', serve], { detached: true, stdio: 'ignore' });
    child.unref();
    writeFileSync(pidFile, String(child.pid));
  }
}
