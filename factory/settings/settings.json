{
  "permissions": {
    "allow": [
      "mcp__factory__advance_item",
      "mcp__factory__log_event",
      "mcp__factory__request_split"
    ],
    "deny": [
      "Artifact",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "EnterPlanMode",
      "EnterWorktree",
      "ExitPlanMode",
      "ExitWorktree",
      "ListAgents",
      "ListMcpResourcesTool",
      "LSP",
      "Monitor",
      "NotebookEdit",
      "PowerShell",
      "PushNotification",
      "ReadMcpResourceTool",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "SendFeedback",
      "SendMessage",
      "SendUserFile",
      "ShareOnboardingGuide",
      "Skill",
      "SubagentHandback",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskStop",
      "TaskUpdate",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "Edit(/.claude/**)",
      "Edit(/.mcp.json)",
      "Edit(/.github/workflows/**)",
      "Edit(/.factory/config)",
      "Edit(/.factory/lockfile-policy)",
      "Edit(/.specify/**)",
      "Edit(**/.gitattributes)",
      "Edit(**/.gitmodules)",
      "Edit(**/CLAUDE.md)",
      "Edit(**/CLAUDE.local.md)",
      "Edit(**/.station.json)",
      "Edit(**/events.jsonl)",
      "Edit(/.factory/events/**)",
      "Edit(**/.git)",
      "Edit(**/.git/**)",
      "Read(~/.factory/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.claude/projects/**)",
      "Read(~/.gitconfig)",
      "Read(~/.config/git/**)",
      "Read(**/.env*)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr merge *)",
      "Bash(factory approve *)",
      "Bash(factory merge *)",
      "Bash(factory deploy *)",
      "Bash(factory resume *)",
      "Bash(factory keygen *)",
      "Bash(ssh-keygen -Y sign *)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "disableClaudeAiConnectors": true,
  "remoteControlAtStartup": false,
  "crossSessionInbound": "refuse",
  "enableArtifact": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "factory",
            "args": ["hook", "session-start"],
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "factory",
            "args": ["hook", "gate"],
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "factory",
            "args": ["hook", "path-guard"],
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "factory",
            "args": ["hook", "read-guard"],
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "factory",
            "args": ["hook", "command-guard"],
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "factory",
            "args": ["hook", "post-edit"]
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "factory",
            "args": ["hook", "log"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "factory",
            "args": ["hook", "stop"]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "factory",
            "args": ["hook", "pre-compact"],
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "advisorModel": "opus",
  "availableModels": ["sonnet", "opus"]
}
